# Copy to .env (git-ignored) and fill in.
# Device for pretrained models: auto | cpu | cuda
RALLYOS_DEVICE=auto
# Pose model input size. 1280 finds far-court players; 640 is ~3x faster but misses them
RALLYOS_MAX_WIDTH=1280
# Ball tracker: auto | geometric | racketvision
RALLYOS_BALL_TRACKER=auto
# Optional: run RacketVision locally (its RacketVision/source checkout and its own venv's python)
RALLYOS_RACKETVISION_ROOT=
RALLYOS_RACKETVISION_PY=
# Optional. Without it the AI coach falls back to templated insights.
ANTHROPIC_API_KEY=
# Backend
# Database. Default: local SQLite file (works offline; relative paths resolve against the repo root).
# Supabase: Dashboard > your project > Connect > "Session pooler" URI (IPv4), with your database password filled in:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The driver and sslmode=require are added automatically. Copy existing data once with:
#   python -m api.migrate_db --to "<the same URL>"
DATABASE_URL=sqlite:///data/rallyos.db
MEDIA_DIR=media
# Human-confirmed score overrides, coach report cache
RUNTIME_DIR=data/runtime
# Serve data/mock/match.json when a match isn't in the DB
MOCK_FALLBACK=true
# AI coach model (full report). Used only when ANTHROPIC_API_KEY is set.
RALLYOS_COACH_MODEL=claude-sonnet-5-5

# Live mode: continuous capture cut into chunks, analysed while the match is played
# Seconds per chunk (the browser cuts one automatically; results lag the camera by about this plus the analysis time)
RALLYOS_CHUNK_SECONDS=5
# Where chunks and the final video are kept: local (default, works fully offline) or cloudinary (durable storage + CDN).
# Heavy video analysis always runs on this laptop; Cloudinary only stores and serves media.
RALLYOS_STORAGE=local
# Only needed with RALLYOS_STORAGE=cloudinary (Cloudinary dashboard > Programmable Media > API Keys). Uploads are SIGNED by the API:
# the secret never reaches the browser. Missing values = local storage, with a warning.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: how long (s) to wait for a chunk that has not arrived while later ones have, before counting it dropped
RALLYOS_LIVE_MISSING_WAIT_S=15

# Database fallback: when DATABASE_URL points at a remote database that cannot be reached at start (offline, a network that
# blocks port 5432, a paused Supabase project) the API uses the local SQLite file instead. Set 0 to fail instead.
RALLYOS_DB_FALLBACK=1

# Pose backend: auto (OpenVINO on CPU when installed, else PyTorch) | torch | openvino
RALLYOS_POSE_BACKEND=auto
# Optional speed tuning for live mode (defaults: 2 pose calls and 3 shuttle searches in flight at once)
# RALLYOS_POSE_WORKERS=2
# RALLYOS_SEARCH_WORKERS=3
# RALLYOS_TORCH_THREADS=
# Set 0 to skip the start-up model warm-up (tests, CI)
# RALLYOS_WARMUP=1
