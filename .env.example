# Copy to .env (git-ignored) and fill in.
# Device for pretrained models: auto | cpu | cuda
RALLYOS_DEVICE=auto
# Mode 2 only: URL of the GPU worker (cloudflared tunnel). Empty = process on local CPU.
RALLYOS_WORKER_URL=
# Max frame width fed to detectors (use 640 for quick CPU test runs)
RALLYOS_MAX_WIDTH=960
# Ball tracker: auto | geometric | racketvision
RALLYOS_BALL_TRACKER=auto
# Optional. Without it the AI coach falls back to templated insights.
ANTHROPIC_API_KEY=
# Backend
DATABASE_URL=sqlite:///./rallyos.db
MEDIA_DIR=./media
