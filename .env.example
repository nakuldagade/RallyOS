# Copy to .env (git-ignored) and fill in.
# Device for pretrained models: auto | cpu | cuda
RALLYOS_DEVICE=auto
# Pose model input size. 1280 finds far-court players; 640 is ~3x faster but misses them
RALLYOS_MAX_WIDTH=1280
# Ball tracker: auto | geometric | racketvision
RALLYOS_BALL_TRACKER=auto
# Optional: run RacketVision locally (its RacketVision/source checkout and its own venv's python)
RALLYOS_RACKETVISION_ROOT=
RALLYOS_RACKETVISION_PY=
# Optional. Without it the AI coach falls back to templated insights.
ANTHROPIC_API_KEY=
# Backend
# Relative paths resolve against the repo root
DATABASE_URL=sqlite:///data/rallyos.db
MEDIA_DIR=media
# Human-confirmed score overrides, coach report cache
RUNTIME_DIR=data/runtime
# Serve data/mock/match.json when a match isn't in the DB
MOCK_FALLBACK=true
# AI coach model (full report). Used only when ANTHROPIC_API_KEY is set.
RALLYOS_COACH_MODEL=claude-sonnet-5-5
